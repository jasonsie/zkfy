{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"pattern\"",
        "hooks": [
          {
            "type": "command",
            "command": "#!/bin/bash\ninput=$(cat)\n# Add validation or modification logic here\necho \"$input\""
          }
        ],
        "description": "Template: validate or modify before bash execution"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool == \"Edit\"",
        "hooks": [
          {
            "type": "command",
            "command": "#!/bin/bash\ninput=$(cat)\n# Add post-processing logic here\necho \"$input\""
          }
        ],
        "description": "Template: process after file edits"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "#!/bin/bash\n# Session initialization logic\necho \"Session started\" >&2"
          }
        ],
        "description": "Template: runs when session starts"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "#!/bin/bash\n# Session cleanup logic\necho \"Session ended\" >&2"
          }
        ],
        "description": "Template: runs when session ends"
      }
    ]
  }
}
